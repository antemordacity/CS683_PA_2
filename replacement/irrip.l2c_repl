#include "cache.h"

/*
 * I-RRIP: Instruction-conscious RRIP for the L2C (2-bit RRPV, SRRIP baseline).
 * RRPV 0 = re-referenced soon (keep), RRPV 3 = evict next.
 *
 * IRRIP_VERSION selects how much of the policy is enabled, so each
 * change can be measured separately:
 *   1 : insertion only  - instruction fills get a better (lower) RRPV
 *   2 : + promotion     - instruction hits go to 0, data hits move only one step
 *   3 : + eviction      - among max-RRPV lines, evict a data line first
 */
#ifndef IRRIP_VERSION
#define IRRIP_VERSION 3
#endif
static_assert(IRRIP_VERSION >= 1 && IRRIP_VERSION <= 3, "IRRIP_VERSION must be 1, 2 or 3");

#define maxRRPV 3
#define INSTR_INSERT_RRPV 0               // instruction fill: kept close to MRU
#define DATA_INSERT_RRPV  (maxRRPV - 1)   // data fill: same as baseline SRRIP (RRPV 2)

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// initialize replacement state: every line starts at maxRRPV (evictable)
void CACHE::l2c_initialize_replacement()
{
    std::cout << "==================================" << std::endl;
    std::cout << "Initializing IRRIP L2C replacement (version " << IRRIP_VERSION << ")" << std::endl;
    std::cout << "==================================" << std::endl;

    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++)
            l2_rrpv[i][j] = maxRRPV;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // Invalidation can leave a low RRPV: empty entries always win.
    for (int way = 0; way < L2C_WAY; ++way)
        if (!current_set[way].valid)
            return way;
    while (1)
    {
#if IRRIP_VERSION >= 3
        // Eviction change: first look for a DATA line at maxRRPV, so that
        // instruction lines (which hurt the frontend when missed) survive longer.
        for (int way = 0; way < L2C_WAY; way++)
            if (l2_rrpv[set][way] == maxRRPV && !current_set[way].instruction)
                return way;
#endif
        // Standard RRIP: any line at maxRRPV (an instruction line only gets
        // evicted here if no data line was at maxRRPV).
        for (int way = 0; way < L2C_WAY; way++)
            if (l2_rrpv[set][way] == maxRRPV)
                return way;

        // nobody at maxRRPV: age the whole set and try again
        for (int way = 0; way < L2C_WAY; way++)
            l2_rrpv[set][way]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit (hit=1) and cache fill (hit=0)
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if (hit)
    {
        // ---- promotion ----
#if IRRIP_VERSION >= 2
        if (isInstruction)
            l2_rrpv[set][way] = 0;                 // instruction reuse: promote fully
        else if (l2_rrpv[set][way] > 0)
            l2_rrpv[set][way]--;                   // data reuse: promote one step only
#else
        l2_rrpv[set][way] = 0;                     // baseline RRIP hit promotion
#endif
    }
    else
    {
        // ---- insertion ----
        l2_rrpv[set][way] = isInstruction ? INSTR_INSERT_RRPV : DATA_INSERT_RRPV;
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
}
