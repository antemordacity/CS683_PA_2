#include "cache.h"
#include<cstring>

#define PREFETCH_DEGREE 1
#define MASK_IP 0xFF
#define IP_TRACKER_COUNT 24
#define PATTERN_WIDTH 2
#define CONF_THRESH 2

typedef enum {
    STATE_UNI_INIT,
    STATE_UNI_TRACK,
    STATE_UNI_CONF,
    STATE_NON_UNI
} PF_STATE;

class IP_TRACKER{
    public:
        uint64_t ip; 
        int64_t strides[PATTERN_WIDTH] ; //observed stride pattern
        uint64_t stride_offset;
        uint64_t last_cl_addr; //last address accessed
        uint32_t lru;
        uint32_t conf_counter;
        PF_STATE state;
        IP_TRACKER () {
            stride_offset = 0;
            conf_counter = 0;
            state = STATE_UNI_INIT;
            ip = 0;
            last_cl_addr = 0;
            std::memset(strides, 0, sizeof(strides)); //n.b. is this okay?
            lru = 0;
    };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];


void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    for (int i=0; i<IP_TRACKER_COUNT; i++)
        	trackers[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    ip = ip & MASK_IP;
    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        //maybe write a function for this?
        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;
        trackers[index].state = STATE_UNI_INIT;
        trackers[index].stride_offset = 0;
        trackers[index].conf_counter = 0;
        std::memset(trackers[index].strides, 0, PATTERN_WIDTH*sizeof(int64_t));

        //cout << "[IP_STRIDE] MISS index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << endl;
	    for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return; //metadata_in;
    }

	// sanity check
    // at this point we should know a matching tracker index
    if (index == -1)
        assert(0);

    //stride calculation
    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }

    //cout << "[IP_STRIDE] HIT  index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << " stride: " << stride << endl;
    if (stride == 0)
        return; //metadata_in
    switch(trackers[index].state){
        case STATE_UNI_INIT:
            trackers[index].conf_counter = 0;
            if(trackers[index].strides[trackers[index].stride_offset] == stride){
                for (int i=0; i<PREFETCH_DEGREE; i++) {
                    uint64_t pf_address = (cl_addr + (stride*(i+1))) << LOG2_BLOCK_SIZE;

                    // only issue a prefetch if the prefetch address is in the same 4 KB page
                    // as the current demand access address
                    if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                        break;

                    // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
                    if (MSHR.occupancy < (MSHR.SIZE>>1))
                        prefetch_line(ip, addr, pf_address, FILL_L1, 0);
                    else
                        prefetch_line(ip, addr, pf_address, FILL_L2, 0);
                }
            }
            trackers[index].stride_offset = 0;
            std::memset(trackers[index].strides, 0, PATTERN_WIDTH*sizeof(int64_t));
            trackers[index].strides[trackers[index].stride_offset] = stride;
            trackers[index].last_cl_addr = cl_addr;
            trackers[index].state = STATE_UNI_TRACK;
            break;
        case STATE_UNI_TRACK:
            if (stride == trackers[index].strides[trackers[index].stride_offset]) {
                trackers[index].state = STATE_UNI_INIT;
                for (int i=0; i<PREFETCH_DEGREE; i++) {
                    uint64_t pf_address = (cl_addr + (stride*(i+1))) << LOG2_BLOCK_SIZE;

                    // only issue a prefetch if the prefetch address is in the same 4 KB page
                    // as the current demand access address
                    if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                        break;

                    // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
                    if (MSHR.occupancy < (MSHR.SIZE>>1))
                        prefetch_line(ip, addr, pf_address, FILL_L1, 0);
                    else
                        prefetch_line(ip, addr, pf_address, FILL_L2, 0);
                }
            }
            else{
                trackers[index].strides[trackers[index].stride_offset++] = stride;
                trackers[index].last_cl_addr = cl_addr;
                if (trackers[index].stride_offset == PATTERN_WIDTH) {
                    trackers[index].stride_offset = 0;
                    trackers[index].state = STATE_UNI_CONF;
                }
            }
            break;
        case STATE_UNI_CONF:
            if(stride == trackers[index].strides[trackers[index].stride_offset++])
                return; //metadata_in
            else
                trackers[index].state = STATE_UNI_INIT;
            if(trackers[index].stride_offset == PATTERN_WIDTH) {
                trackers[index].stride_offset = 0;
                trackers[index].conf_counter++;
                if (trackers[index].conf_counter >= CONF_THRESH) {
                    trackers[index].state = STATE_NON_UNI;
                }
            }
            break;
        case STATE_NON_UNI:

            break;
    }

}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

